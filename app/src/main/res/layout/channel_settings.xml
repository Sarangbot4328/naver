                <RadioButton android:id="@+id/source_naver" android:layout_width="match_parent"
                    android:layout_height="48dp" android:text="네이버 웹툰" />
                <RadioButton android:id="@+id/source_ililtoon" android:layout_width="match_parent"
                    android:layout_height="48dp" android:text="일일툰" />
                <RadioButton android:id="@+id/source_blacktoon" android:layout_width="match_parent"
                    android:layout_height="48dp" android:text="블랙툰" />
                <RadioButton android:id="@+id/source_wolfdot" android:layout_width="match_parent"
                    android:layout_height="48dp" android:text="늑대닷컴" />
                <RadioButton android:id="@+id/source_hitomi" android:layout_width="match_parent"
                    android:layout_height="48dp" android:text="히토미" />
                <RadioButton android:id="@+id/source_toonkor" android:layout_width="match_parent"
                    android:layout_height="48dp" android:text="&#xD230;&#xCF54;" />
                <RadioButton android:id="@+id/source_funbe" android:layout_width="match_parent"
                    android:layout_height="48dp" android:text="&#xD380;&#xBE44;" />
                <RadioButton android:id="@+id/source_newtoki" android:layout_width="match_parent"
                    android:layout_height="48dp" android:text="뉴토끼" />
                <RadioButton android:id="@+id/source_site_addresses" android:layout_width="match_parent"
                    android:layout_height="48dp" android:text="웹툰 사이트 주소 확인" />
                <RadioButton android:id="@+id/source_server" android:layout_width="match_parent"
                    android:layout_height="48dp" android:text="서버 연결" />
            </RadioGroup>
            <LinearLayout android:id="@+id/funbe_address_box" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:orientation="vertical" android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="&#xD380;&#xBE44; &#xC8FC;&#xC18C;" android:textColor="@color/text_primary" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="&#xC8FC;&#xC18C;&#xAC00; &#xBCC0;&#xACBD;&#xB418;&#xBA74; &#xC0C8; &#xC8FC;&#xC18C;&#xB97C; &#xC785;&#xB825;&#xD558;&#xACE0; &#xC800;&#xC7A5;&#xD558;&#xC138;&#xC694;."
                    android:textColor="@color/text_secondary" android:textSize="12sp" />
                <EditText android:id="@+id/funbe_url" android:layout_width="match_parent"
                    android:layout_height="52dp" android:layout_marginTop="8dp"
                    android:hint="https://funbe662.com" android:inputType="textUri"
                    android:maxLines="1" android:paddingHorizontal="12dp" />
                <Button android:id="@+id/save_funbe_url" android:layout_width="match_parent"
                    android:layout_height="48dp" android:layout_marginTop="8dp"
                    android:text="&#xD380;&#xBE44; &#xC8FC;&#xC18C; &#xC800;&#xC7A5;" android:textAllCaps="false" />
            </LinearLayout>
            <LinearLayout android:id="@+id/newtoki_address_box" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:orientation="vertical" android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="뉴토끼 주소" android:textColor="@color/text_primary" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="주소가 변경되면 새 주소를 입력하고 저장하세요."
                    android:textColor="@color/text_secondary" android:textSize="12sp" />
                <EditText android:id="@+id/newtoki_url" android:layout_width="match_parent"
                    android:layout_height="52dp" android:layout_marginTop="8dp"
                    android:hint="https://newto29.com" android:inputType="textUri"
                    android:maxLines="1" android:paddingHorizontal="12dp" />
                <Button android:id="@+id/save_newtoki_url" android:layout_width="match_parent"
                    android:layout_height="48dp" android:layout_marginTop="8dp"
                    android:text="뉴토끼 주소 저장" android:textAllCaps="false" />
            </LinearLayout>
            <LinearLayout android:id="@+id/server_address_box" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:orientation="vertical" android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="서버 주소 (선택)" android:textColor="@color/text_primary" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="같은 Wi-Fi에서 자동으로 찾습니다. 자동 연결이 안 되면 서버 화면에 보이는 IP를 입력하세요. 예: 192.168.0.10 또는 192.168.0.10:17891"
                    android:textColor="@color/text_secondary" android:textSize="12sp" />
                <EditText android:id="@+id/server_url" android:layout_width="match_parent"
                    android:layout_height="52dp" android:layout_marginTop="8dp"
                    android:hint="192.168.0.10:17891" android:inputType="textUri"
                    android:maxLines="1" android:paddingHorizontal="12dp" />
                <Button android:id="@+id/save_server_url" android:layout_width="match_parent"
                    android:layout_height="48dp" android:layout_marginTop="8dp"
                    android:text="서버 주소 저장·연결" android:textAllCaps="false" />
                <TextView android:id="@+id/server_connection_status"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/ililtoon_address_box" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:orientation="vertical" android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="일일툰 주소" android:textColor="@color/text_primary" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="5dp" android:text="주소가 변경되면 새 주소를 입력하고 저장하세요."
                    android:textColor="@color/text_secondary" android:textSize="12sp" />
                <EditText android:id="@+id/ililtoon_url" android:layout_width="match_parent"
                    android:layout_height="52dp" android:layout_marginTop="8dp"
                    android:hint="https://11toon148.com" android:inputType="textUri"
                    android:maxLines="1" android:paddingHorizontal="12dp" />
                <Button android:id="@+id/save_ililtoon_url" android:layout_width="match_parent"
                    android:layout_height="48dp" android:layout_marginTop="8dp"
                    android:text="일일툰 주소 저장" android:textAllCaps="false" />
            </LinearLayout>
            <LinearLayout android:id="@+id/blacktoon_address_box" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:orientation="vertical" android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="블랙툰 주소" android:textColor="@color/text_primary" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="5dp" android:text="주소가 변경되면 새 주소를 입력하고 저장하세요."
                    android:textColor="@color/text_secondary" android:textSize="12sp" />
                <EditText android:id="@+id/blacktoon_url" android:layout_width="match_parent"
                    android:layout_height="52dp" android:layout_marginTop="8dp"
                    android:hint="https://blacktoon416.com" android:inputType="textUri"
                    android:maxLines="1" android:paddingHorizontal="12dp" />
                <Button android:id="@+id/save_blacktoon_url" android:layout_width="match_parent"
                    android:layout_height="48dp" android:layout_marginTop="8dp"
                    android:text="블랙툰 주소 저장" android:textAllCaps="false" />
            </LinearLayout>
            <LinearLayout android:id="@+id/wolfdot_address_box" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:orientation="vertical" android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="늑대닷컴 주소" android:textColor="@color/text_primary" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="5dp" android:text="주소가 변경되면 새 주소를 입력하고 저장하세요."
                    android:textColor="@color/text_secondary" android:textSize="12sp" />
                <EditText android:id="@+id/wolfdot_url" android:layout_width="match_parent"
                    android:layout_height="52dp" android:layout_marginTop="8dp"
                    android:hint="https://wfwf421.com" android:inputType="textUri"
                    android:maxLines="1" android:paddingHorizontal="12dp" />
                <Button android:id="@+id/save_wolfdot_url" android:layout_width="match_parent"
                    android:layout_height="48dp" android:layout_marginTop="8dp"
                    android:text="늑대닷컴 주소 저장" android:textAllCaps="false" />
            </LinearLayout>
            <LinearLayout android:id="@+id/hitomi_address_box" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:orientation="vertical" android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="히토미 주소" android:textColor="@color/text_primary" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="5dp" android:text="주소가 변경되면 새 주소를 입력하고 저장하세요."
                    android:textColor="@color/text_secondary" android:textSize="12sp" />
                <EditText android:id="@+id/hitomi_url" android:layout_width="match_parent"
                    android:layout_height="52dp" android:layout_marginTop="8dp"
                    android:hint="https://hitomi.la" android:inputType="textUri"
                    android:maxLines="1" android:paddingHorizontal="12dp" />
                <Button android:id="@+id/save_hitomi_url" android:layout_width="match_parent"
                    android:layout_height="48dp" android:layout_marginTop="8dp"
                    android:text="히토미 주소 저장" android:textAllCaps="false" />
            </LinearLayout>
            <LinearLayout android:id="@+id/toonkor_address_box" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:orientation="vertical" android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="&#xD230;&#xCF54; &#xC8FC;&#xC18C;" android:textColor="@color/text_primary" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="5dp" android:text="&#xC8FC;&#xC18C;&#xAC00; &#xBCC0;&#xACBD;&#xB418;&#xBA74; &#xC0C8; &#xC8FC;&#xC18C;&#xB97C; &#xC785;&#xB825;&#xD558;&#xACE0; &#xC800;&#xC7A5;&#xD558;&#xC138;&#xC694;."
                    android:textColor="@color/text_secondary" android:textSize="12sp" />
                <EditText android:id="@+id/toonkor_url" android:layout_width="match_parent"
                    android:layout_height="52dp" android:layout_marginTop="8dp"
                    android:hint="https://tkor137.com" android:inputType="textUri"
                    android:maxLines="1" android:paddingHorizontal="12dp" />
                <Button android:id="@+id/save_toonkor_url" android:layout_width="match_parent"
                    android:layout_height="48dp" android:layout_marginTop="8dp"
                    android:text="&#xD230;&#xCF54; &#xC8FC;&#xC18C; &#xC800;&#xC7A5;" android:textAllCaps="false" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="22dp" android:background="@color/surface"
            android:orientation="vertical" android:padding="18dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="사이트 주소 자동 갱신" android:textColor="@color/text_primary"
                android:textSize="17sp" android:textStyle="bold" />
            <Button android:id="@+id/refresh_site_addresses"
                android:layout_width="match_parent" android:layout_height="50dp"
                android:layout_marginTop="12dp" android:text="사이트 주소 갱신"
                android:textAllCaps="false" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="갱신 대상: 일일툰 · 블랙툰 · 늑대닷컴 · 툰코 · 펀비 · 뉴토끼\n메이저링크의 무료웹툰 목록에서 최신 주소를 확인합니다. 뉴토끼는 현재 주소부터 번호를 1씩 올려 최대 5번 추가 확인합니다. 찾지 못한 사이트의 기존 주소는 그대로 유지합니다."
                android:textColor="@color/text_secondary" android:textSize="13sp" />
            <TextView android:id="@+id/site_address_update_status"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="22dp" android:background="@color/surface"
            android:orientation="vertical" android:padding="18dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="&#xC811;&#xC18D; &#xD638;&#xD658;&#xC131;" android:textColor="@color/text_primary"
                android:textSize="17sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="&#xD55C;&#xAD6D; &#xD68C;&#xC120;&#xC774;&#xB098; &#xC77C;&#xBD80; &#xD734;&#xB300;&#xD3F0;&#xC5D0;&#xC11C; &#xC0AC;&#xC774;&#xD2B8; &#xC811;&#xC18D;&#xC774; &#xB9C9;&#xD790; &#xB54C; &#xC0AC;&#xC6A9;&#xD569;&#xB2C8;&#xB2E4;. &#xC2E4;&#xC81C; WebView UA, &#xC9C1;&#xC811; &#xC8FC;&#xC18C;, &#xC624;&#xB958; &#xC9C4;&#xB2E8;, &#xC678;&#xBD80; &#xBE0C;&#xB77C;&#xC6B0;&#xC800; &#xB300;&#xCCB4;&#xC640; &#xB2E4;&#xC6B4;&#xB85C;&#xB4DC; &#xD5E4;&#xB354; &#xC77C;&#xCE58;&#xB97C; &#xD55C;&#xBC88;&#xC5D0; &#xC801;&#xC6A9;&#xD569;&#xB2C8;&#xB2E4;."
                android:textColor="@color/text_secondary" android:textSize="13sp" />
            <CheckBox android:id="@+id/compatibility_mode"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="&#xD638;&#xD658; &#xC811;&#xC18D; &#xBAA8;&#xB4DC; &#xC0AC;&#xC6A9;" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="22dp" android:background="@color/surface"
            android:orientation="vertical" android:padding="18dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="웹툰 보기 방식" android:textColor="@color/text_primary"
                android:textSize="17sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="7dp" android:text="다운로드한 회차를 볼 때 페이지 넘김 방식을 선택합니다."
                android:textColor="@color/text_secondary" android:textSize="13sp" />
            <RadioGroup android:id="@+id/view_mode_group" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:orientation="vertical">
                <RadioButton android:id="@+id/view_mode_scroll" android:layout_width="match_parent"
                    android:layout_height="48dp" android:text="웹툰 방식 (아래로 스크롤)" />
                <RadioButton android:id="@+id/view_mode_page_fit" android:layout_width="match_parent"
                    android:layout_height="48dp" android:text="만화책 모드 1 (양면 오른쪽 → 왼쪽)" />
                <RadioButton android:id="@+id/view_mode_page" android:layout_width="match_parent"
                    android:layout_height="48dp" android:text="만화책 모드 2 (양면 왼쪽 → 오른쪽)" />
            </RadioGroup>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="22dp" android:background="@color/surface"
            android:orientation="vertical" android:padding="18dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="자동 넘기기" android:textColor="@color/text_primary"
                android:textSize="17sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="다운로드한 회차를 보는 화면에서만 지정한 간격마다 자동으로 한 번씩 넘깁니다. 뷰어 화면을 빠르게 두 번 터치하면 일시 중단하거나 다시 시작할 수 있습니다."
                android:textColor="@color/text_secondary" android:textSize="13sp" />
            <CheckBox android:id="@+id/auto_advance" android:layout_width="match_parent"
                android:layout_height="48dp" android:layout_marginTop="8dp"
                android:text="자동 넘기기 사용" />
            <LinearLayout android:id="@+id/auto_advance_options"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="넘기기 간격(초)"
                    android:textColor="@color/text_primary" android:textStyle="bold" />
                <EditText android:id="@+id/auto_advance_seconds"
                    android:layout_width="match_parent" android:layout_height="52dp"
                    android:layout_marginTop="8dp" android:hint="2" android:inputType="number"
                    android:maxLength="4" android:maxLines="1" android:paddingHorizontal="12dp" />
                <Button android:id="@+id/save_auto_advance_seconds"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:layout_marginTop="8dp" android:text="넘기기 간격 저장"
                    android:textAllCaps="false" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="22dp" android:background="@color/surface"
            android:orientation="vertical" android:padding="18dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
